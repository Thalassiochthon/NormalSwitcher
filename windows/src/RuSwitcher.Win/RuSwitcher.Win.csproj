<Project Sdk="Microsoft.NET.Sdk">

  <!-- NormalSwitcher for Windows. No external (NuGet) dependencies. Low-level engine (LL hook,
       SendInput injection, tray) is raw Win32 P/Invoke; WinForms (first-party .NET) is used
       only for the clipboard and the settings window. EnableWindowsTargeting lets it also
       compile on macOS (P/Invoke compiles, can't run) for a fast local compile-check; the real
       build/test/exe come from the windows-latest CI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>RuSwitcher.Win</RootNamespace>
    <AssemblyName>NormalSwitcher</AssemblyName>
    <Product>NormalSwitcher</Product>
    <Description>NormalSwitcher for Windows</Description>
    <ApplicationIcon>NormalSwitcher.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Platforms>x64;ARM64</Platforms>
    <!-- Windows track starts pre-1.0 (beta). Keep in sync with windows/version.json. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <EmbeddedResource Include="../../../shared/layout-sounds/*.wav" LogicalName="LayoutSounds.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../dicts/en.v1.deflate" LogicalName="WordPacks.en.deflate" />
    <EmbeddedResource Include="../../../dicts/ru.v1.deflate" LogicalName="WordPacks.ru.deflate" />
    <EmbeddedResource Include="../../../dicts/LICENSE" LogicalName="WordPacks.LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <!-- Let the test project reach internal engine types (AutoConverter verdict, etc.). -->
    <InternalsVisibleTo Include="RuSwitcher.Win.Tests" />
  </ItemGroup>

</Project>
